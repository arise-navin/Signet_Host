{
  "name": "hospital-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=../prisma/schema.prisma && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --external:dotenv --external:@prisma/client --external:bcryptjs --external:fastify --external:@fastify/cors --external:@fastify/jwt",
    "start": "node dist/index.mjs",
    "seed": "tsx ../prisma/seed.ts",
    "studio": "prisma studio --schema=../prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.5",
    "@hospital/agents": "*",
    "@hospital/ai-provider": "*",
    "@hospital/shared": "*",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
