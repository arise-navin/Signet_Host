# ==========================================
# Hospital AI Agent Application Environment
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (For Vercel, use Cloud PostgreSQL like Neon, Supabase, or AWS RDS)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/hospital_ai_db?sslmode=require"

# AI Provider Configuration (Groq Cloud)
AI_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REQUESTED_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_EFFORT="medium"

# Local Ollama Fallback (if running locally)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="beam:cloud"
OLLAMA_REQUESTED_MODEL="beam:cloude"

# Security & Demo Auth
JWT_SECRET="6406a7942879b4484f66b1823130b7b14fc6ca5878a3c5071c1028f7820eca5dce0ff03a707bbd0aae6b236b"
BCRYPT_ROUNDS=12
BOOTSTRAP_ADMIN_PASSWORD="change_me_in_production"
DEMO_AUTH_ENABLED=true

# Frontend Vite Proxy / Origin
FRONTEND_ORIGIN="*"
HOSPITAL_TIMEZONE="Asia/Kolkata"
