# ==========================================
# HOSPITAL AI MULTI-AGENT APPLICATION
# ==========================================

# 1. SERVER CONFIGURATION
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ==========================================
# 2. NEON POSTGRESQL DATABASE
# ==========================================

# Pooled Connection - Application Runtime
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct Connection - Prisma Migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Pooled Connection - Compatibility
DATABASE_URL_POOLED="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==========================================
# 3. GROQ CLOUD AI CONFIGURATION
# ==========================================

AI_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REQUESTED_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_EFFORT="medium"

# ==========================================
# 4. AUTHENTICATION & SECURITY
# ==========================================

JWT_SECRET="6406a7942879b4484f66b1823130b7b14fc6ca5878a3c5071c1028f7820eca5dce0ff03a707bbd0aae6b236b"
BCRYPT_ROUNDS=12

# Development only - Change before production
BOOTSTRAP_ADMIN_PASSWORD="change_me_in_production"
DEMO_AUTH_ENABLED=true

# ==========================================
# 5. FRONTEND & BACKEND CONNECTION
# ==========================================

# Development CORS - Restrict in production
FRONTEND_ORIGIN="*"

# Local Development API URL
VITE_API_URL="http://localhost:3001"

# ==========================================
# 6. HOSPITAL TIMEZONE
# ==========================================

HOSPITAL_TIMEZONE="Asia/Kolkata"

# ==========================================
# END OF CONFIGURATION
# ==========================================
