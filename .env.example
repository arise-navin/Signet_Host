# ==========================================
# Hospital AI Agent Application Environment
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Neon PostgreSQL - Runtime Connection (Pooled)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/hospital_ai_db?sslmode=require"

# Neon PostgreSQL - Direct Connection (Migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/hospital_ai_db?sslmode=require"

# Compatibility with existing configuration
DATABASE_URL_POOLED="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/hospital_ai_db?sslmode=require"

# AI Provider Configuration (Groq Cloud)
AI_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REQUESTED_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_EFFORT="medium"

# Security & Demo Auth
JWT_SECRET="6406a7942879b4484f66b1823130b7b14fc6ca5878a3c5071c1028f7820eca5dce0ff03a707bbd0aae6b236b"
BCRYPT_ROUNDS=12
BOOTSTRAP_ADMIN_PASSWORD="change_me_in_production"
DEMO_AUTH_ENABLED=true

# Frontend Vite Proxy / Origin
FRONTEND_ORIGIN="*"
VITE_API_URL="http://localhost:3001"
HOSPITAL_TIMEZONE="Asia/Kolkata"
